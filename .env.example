# -----------------------------------------------------------------------
# RAILWAY DEPLOYMENT NOTES
# -----------------------------------------------------------------------
# Below, each variable is tagged with how it should be set on Railway:
#   [MANUAL]     you must set this yourself in the Railway service's
#                Variables tab — nothing injects it automatically.
#   [RAILWAY]    Railway injects/provides this automatically for the
#                given plugin (do not hardcode a value for these).
#   [REFERENCE]  set it yourself on the app/worker/scheduler services,
#                but its VALUE should be a Railway variable reference
#                to the Postgres/Redis plugin, e.g. ${{Postgres.PGHOST}}
#                or ${{Redis.REDISHOST}} (Settings -> Variables -> "Add
#                Reference" in the Railway dashboard).
# This project reads discrete DB_*/REDIS_* host/port/user/pass vars (NOT
# DATABASE_URL/REDIS_URL directly), so on Railway you reference the
# Postgres/Redis plugin's discrete variables instead of parsing the URL:
#   DB_HOST=${{Postgres.PGHOST}}        DB_PORT=${{Postgres.PGPORT}}
#   DB_DATABASE=${{Postgres.PGDATABASE}} DB_USERNAME=${{Postgres.PGUSER}}
#   DB_PASSWORD=${{Postgres.PGPASSWORD}}
#   REDIS_HOST=${{Redis.REDISHOST}}     REDIS_PORT=${{Redis.REDISPORT}}
#   REDIS_PASSWORD=${{Redis.REDISPASSWORD}}
# -----------------------------------------------------------------------

APP_NAME="Banijya Shop"
APP_ENV=local
# [MANUAL] production: generate once (`php artisan key:generate --show`) and
# paste as a fixed value — do NOT regenerate on every deploy, it invalidates
# all sessions/encrypted data.
APP_KEY=
# [MANUAL] production: must be false.
APP_DEBUG=true
# [MANUAL] production: your Railway-assigned public domain, e.g.
# https://banijya-shop-production.up.railway.app
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# [MANUAL] production: set LOG_CHANNEL=stderr so logs show up in the Railway
# dashboard (container filesystem is not persisted between deploys, so the
# default "single" file channel is not useful in production).
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# [REFERENCE] production: ${{Postgres.PGHOST}}
DB_HOST=127.0.0.1
# [REFERENCE] production: ${{Postgres.PGPORT}}
DB_PORT=5432
# [REFERENCE] production: ${{Postgres.PGDATABASE}}
DB_DATABASE=banijya_ecommerce
# [REFERENCE] production: ${{Postgres.PGUSER}}
DB_USERNAME=postgres
# [REFERENCE] production: ${{Postgres.PGPASSWORD}}
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
# [REFERENCE] production: ${{Redis.REDISHOST}}
REDIS_HOST=127.0.0.1
# [REFERENCE] production: ${{Redis.REDISPASSWORD}}
REDIS_PASSWORD=null
# [REFERENCE] production: ${{Redis.REDISPORT}}
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default

# [MANUAL] production: real SMTP provider credentials (Mailpit is local-only).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@banijyashop.test"
MAIL_FROM_NAME="${APP_NAME}"

# [MANUAL] production: real S3/Cloudflare R2 credentials + bucket (MinIO
# values below are local-dev only and unreachable from Railway).
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=banijya-product-images
AWS_URL=http://127.0.0.1:9000/banijya-product-images
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# [RAILWAY] injected automatically by Railway into every service's
# environment — do not set manually. Read by docker/start-container.sh /
# php artisan serve --port=$PORT.
# PORT=

# [MANUAL] set to "false" on the worker and scheduler Railway services only
# (web keeps the default "true") — see docker/start-container.sh.
# RUN_MIGRATIONS=true
